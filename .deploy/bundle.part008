__d(function(g,r,i,_a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"tierInfo",{enumerable:!0,get:function(){return s}}),Object.defineProperty(e,"worlds",{enumerable:!0,get:function(){return u}}),Object.defineProperty(e,"totalLessonCount",{enumerable:!0,get:function(){return c}});var t=r(d[0]),n=r(d[1]),a=r(d[2]),o=r(d[3]);const s={beginner:{title:'AI Explorer',emoji:'\ud83c\udf31',description:'Start from zero. No experience needed!'},intermediate:{title:'AI Builder',emoji:'\ud83d\udd27',description:'Go under the hood of neural networks.'},advanced:{title:'AI Master',emoji:'\ud83e\udde0',description:'GenAI, agents & cloud certification prep.'}},l={beginner:0,intermediate:1,advanced:2},u=[{id:'w1',tier:'beginner',title:'Planet Basics',subtitle:'What even is AI?',emoji:'\ud83c\udf0d',lessons:[{id:'w1l1',title:'Meet AI',emoji:'\ud83e\udd16',xp:50,cards:[{emoji:'\ud83e\udd16',title:'What is AI?',body:'Artificial Intelligence is teaching computers to do things that normally need human smarts \u2014 like recognizing faces, understanding speech, or recommending your next favorite song.'},{emoji:'\ud83e\udde0',title:'AI is everywhere',body:'Your phone unlocking with your face? AI. Netflix suggestions? AI. Spam filters? AI. You already use AI dozens of times a day without noticing!'},{emoji:'\ud83d\udcca',title:'AI learns from data',body:'Instead of being programmed with exact rules, modern AI learns patterns from examples \u2014 just like you learned to recognize cats by seeing many cats, not by reading a cat manual.'}],quiz:[{question:'What does AI learn from?',options:['Magic','Data and examples','Only human rules','Electricity'],answerIndex:1,explanation:'Modern AI learns patterns from data \u2014 lots of examples!'},{question:'Which of these uses AI?',options:['Face unlock','Netflix recommendations','Spam filters','All of the above'],answerIndex:3,explanation:'AI is all around you \u2014 all of these use it!'}]},{id:'w1l2',title:'AI vs ML vs DL',emoji:'\ud83c\udfaf',xp:50,cards:[{emoji:'\ud83c\udfaf',title:'The Russian dolls',body:'AI is the big idea (machines acting smart). Machine Learning (ML) is a way to achieve AI (learning from data). Deep Learning (DL) is a powerful type of ML using neural networks.'},{emoji:'\ud83e\ude86',title:'AI \u2283 ML \u2283 DL',body:'Think of nested dolls: Deep Learning sits inside Machine Learning, which sits inside AI. Every DL system is ML, and every ML system is AI \u2014 but not the other way around.'},{emoji:'\u2699\ufe0f',title:'Classic AI vs ML',body:'Old-school AI used hand-written rules ("if email contains FREE MONEY, mark spam"). ML flips it: show the machine thousands of spam emails and it figures out the rules itself.'}],quiz:[{question:'Which is the broadest term?',options:['Deep Learning','Machine Learning','AI','Neural Networks'],answerIndex:2,explanation:'AI is the umbrella \u2014 ML and DL live inside it.'},{question:'How does ML differ from rule-based AI?',options:['ML learns rules from data','ML is slower','ML needs no computers','No difference'],answerIndex:0,explanation:'ML discovers patterns from examples instead of hand-coded rules.'}]},{id:'w1l3',title:'Types of ML',emoji:'\ud83d\uddc2\ufe0f',xp:60,cards:[{emoji:'\ud83d\udc69\u200d\ud83c\udfeb',title:'Supervised Learning',body:'Learning with labeled examples. Show the model photos labeled "cat" or "dog" and it learns to tell them apart. Used for: spam detection, price prediction, image classification.'},{emoji:'\ud83d\udd75\ufe0f',title:'Unsupervised Learning',body:'Learning WITHOUT labels. The model finds hidden patterns on its own \u2014 like grouping customers by shopping behavior. Used for: clustering, anomaly detection.'},{emoji:'\ud83c\udfae',title:'Reinforcement Learning',body:'Learning by trial and error with rewards \u2014 like training a dog with treats. This is how AI mastered chess, Go, and video games!'}],quiz:[{question:'Training with labeled data is called\u2026',options:['Unsupervised learning','Supervised learning','Reinforcement learning','Transfer learning'],answerIndex:1,explanation:'Labels = supervision. The model learns from labeled examples.'},{question:'AI learning a game via rewards uses\u2026',options:['Supervised learning','Clustering','Reinforcement learning','Regression'],answerIndex:2,explanation:'Trial + error + rewards = reinforcement learning.'},{question:'Grouping customers with no labels is\u2026',options:['Clustering (unsupervised)','Classification','Regression','Reinforcement'],answerIndex:0,explanation:'No labels + finding groups = unsupervised clustering.'}]}]},{id:'w2',tier:'beginner',title:'Data Galaxy',subtitle:'Fuel of all AI',emoji:'\ud83c\udf0c',lessons:[{id:'w2l1',title:'Data 101',emoji:'\ud83d\udce6',xp:50,cards:[{emoji:'\ud83d\udce6',title:'Data is the fuel',body:'AI without data is like a car without fuel. Data can be numbers, text, images, audio, video \u2014 anything a computer can store.'},{emoji:'\ud83c\udff7\ufe0f',title:'Features & labels',body:'Features are the inputs (house size, location). Labels are the answers (house price). ML learns the mapping: features \u2192 label.'},{emoji:'\u2702\ufe0f',title:'Train / test split',body:'We split data: most for training (learning), some held back for testing (checking if the model really learned or just memorized).'}],quiz:[{question:'In house price prediction, the price is the\u2026',options:['Feature','Label','Model','Algorithm'],answerIndex:1,explanation:'The label is what we predict \u2014 here, the price.'},{question:'Why keep a test set?',options:['To train faster','To verify the model generalizes','To save storage','No reason'],answerIndex:1,explanation:'Test data checks the model works on unseen examples.'}]},{id:'w2l2',title:'Good vs Bad Data',emoji:'\ud83e\uddf9',xp:60,cards:[{emoji:'\ud83d\uddd1\ufe0f',title:'Garbage in, garbage out',body:'A model trained on bad data makes bad predictions. Data quality beats data quantity. Cleaning data is 80% of a data scientist\'s job!'},{emoji:'\u2696\ufe0f',title:'Bias in data',body:'If training data mostly shows one group, the model performs poorly for others. Biased data \u2192 biased AI. This is one of the biggest ethical issues in AI.'},{emoji:'\ud83c\udfad',title:'Overfitting',body:'When a model memorizes training data instead of learning patterns, it fails on new data. Like memorizing exam answers instead of understanding the subject!'}],quiz:[{question:'"Garbage in, garbage out" means\u2026',options:['Delete old data','Bad data \u2192 bad model','Models create garbage','Recycle data'],answerIndex:1,explanation:'Model quality depends on data quality.'},{question:'A model acing training data but failing new data is\u2026',options:['Underfitting','Overfitting','Perfect','Biased'],answerIndex:1,explanation:'Memorizing instead of generalizing = overfitting.'}]}]},{id:'w3',tier:'intermediate',title:'Neural Nebula',subtitle:'Inside the brain of AI',emoji:'\ud83e\udde0',lessons:[{id:'w3l1',title:'Neural Networks',emoji:'\ud83d\udd78\ufe0f',xp:80,cards:[{emoji:'\ud83e\udde0',title:'Inspired by brains',body:'Neural networks are layers of tiny units ("neurons") connected together. Each neuron takes inputs, multiplies by weights, adds bias, and passes the result through an activation function.'},{emoji:'\ud83e\udd5e',title:'Layers',body:'Input layer (your data) \u2192 hidden layers (pattern detectors) \u2192 output layer (the answer). "Deep" learning = many hidden layers.'},{emoji:'\ud83c\udf9a\ufe0f',title:'Weights = knowledge',body:'Training a network means adjusting millions of weights until predictions match reality. The weights ARE the learned knowledge.'}],quiz:[{question:'What makes deep learning "deep"?',options:['Deep thoughts','Many hidden layers','Big data','Deep code'],answerIndex:1,explanation:'Depth = number of hidden layers stacked together.'},{question:'What stores a network\'s learned knowledge?',options:['The weights','The dataset','The GPU','The code'],answerIndex:0,explanation:'Training adjusts weights \u2014 they encode everything learned.'}]},{id:'w3l2',title:'Training Deep Dive',emoji:'\ud83c\udfcb\ufe0f',xp:80,cards:[{emoji:'\ud83d\udcc9',title:'Loss function',body:'The loss measures how wrong the model is. Training = minimizing loss. Lower loss = better predictions.'},{emoji:'\u26f0\ufe0f',title:'Gradient descent',body:'Imagine descending a mountain in fog \u2014 you feel the slope and step downhill. Gradient descent adjusts weights step-by-step toward lower loss. The step size is the "learning rate".'},{emoji:'\ud83d\udd01',title:'Backpropagation',body:'The algorithm that computes how much each weight contributed to the error, so we know which direction to nudge every weight. It\'s the engine of deep learning.'}],quiz:[{question:'Gradient descent minimizes the\u2026',options:['Learning rate','Loss function','Dataset','Layer count'],answerIndex:1,explanation:'We descend the loss landscape to find better weights.'},{question:'Backpropagation computes\u2026',options:['Data labels','Weight gradients','GPU speed','Accuracy'],answerIndex:1,explanation:'It propagates error backwards to compute each weight\'s gradient.'}]},{id:'w3l3',title:'CNNs & Vision',emoji:'\ud83d\udc41\ufe0f',xp:90,cards:[{emoji:'\ud83d\udc41\ufe0f',title:'Convolutional networks',body:'CNNs scan images with small filters that detect edges, textures, then shapes, then objects. Layer by layer, they build understanding from pixels.'},{emoji:'\ud83d\uddbc\ufe0f',title:'Computer vision wins',body:'CNNs power face recognition, medical imaging, self-driving car perception, and photo search. In 2012, a CNN (AlexNet) crushed the ImageNet contest and started the deep learning revolution.'},{emoji:'\ud83c\udf9b\ufe0f',title:'Pooling & filters',body:'Filters slide over images detecting patterns; pooling shrinks the image keeping the strongest signals \u2014 making detection robust to position shifts.'}],quiz:[{question:'CNNs are best known for\u2026',options:['Text generation','Image understanding','Audio only','Databases'],answerIndex:1,explanation:'Convolutions excel at visual pattern detection.'},{question:'What do early CNN layers detect?',options:['Whole objects','Edges and textures','Labels','Faces only'],answerIndex:1,explanation:'Early layers find simple patterns; deeper layers combine them into objects.'}]}]},{id:'w4',tier:'intermediate',title:'Language Lagoon',subtitle:'Machines that understand words',emoji:'\ud83d\udcac',lessons:[{id:'w4l1',title:'NLP Basics',emoji:'\ud83d\udcdd',xp:80,cards:[{emoji:'\ud83d\udcdd',title:'Natural Language Processing',body:'NLP is how machines read, understand, and generate human language \u2014 powering translation, chatbots, sentiment analysis, and search engines.'},{emoji:'\ud83d\udd22',title:'Words become numbers',body:'Computers only understand numbers, so words are converted to vectors called "embeddings". Similar words get similar vectors: king \u2212 man + woman \u2248 queen!'},{emoji:'\ud83e\udde9',title:'Tokens',body:'Text is chopped into tokens (words or word-pieces). "unbelievable" might become "un" + "believ" + "able". Models process tokens, not raw text.'}],quiz:[{question:'Embeddings represent words as\u2026',options:['Pictures','Vectors of numbers','Sounds','Rules'],answerIndex:1,explanation:'Embeddings map words into number-space where meaning = distance.'},{question:'What are tokens?',options:['Coins for AI','Chunks of text models process','Passwords','Labels'],answerIndex:1,explanation:'Tokens are the word-pieces language models actually read.'}]},{id:'w4l2',title:'Transformers & LLMs',emoji:'\u26a1',xp:100,cards:[{emoji:'\u26a1',title:'Attention is all you need',body:'The 2017 Transformer architecture introduced "attention" \u2014 letting models weigh which words matter to each other, no matter how far apart. It changed AI forever.'},{emoji:'\ud83d\udde3\ufe0f',title:'Large Language Models',body:'LLMs like GPT are giant transformers trained on internet-scale text to predict the next token. From that simple goal emerges reasoning, coding, and conversation.'},{emoji:'\ud83c\udf93',title:'Pretraining \u2192 fine-tuning',body:'LLMs first learn general language (pretraining), then get specialized with fine-tuning and human feedback (RLHF) to be helpful and safe.'}],quiz:[{question:'The key mechanism in Transformers is\u2026',options:['Convolution','Attention','Pooling','Recursion'],answerIndex:1,explanation:'"Attention Is All You Need" \u2014 the famous 2017 paper title!'},{question:'LLMs are fundamentally trained to\u2026',options:['Predict the next token','Translate only','Play games','Store databases'],answerIndex:0,explanation:'Next-token prediction at massive scale creates surprising abilities.'}]}]},{id:'w5',tier:'advanced',title:'GenAI Summit',subtitle:'The cutting edge',emoji:'\ud83d\ude80',lessons:[{id:'w5l1',title:'Generative AI',emoji:'\ud83c\udfa8',xp:120,cards:[{emoji:'\ud83c\udfa8',title:'AI that creates',body:'Generative AI produces new content: text (GPT), images (diffusion models like Stable Diffusion), audio, video, and code. It learned the patterns of creation from millions of examples.'},{emoji:'\ud83c\udf2b\ufe0f',title:'Diffusion models',body:'Image generators learn by adding noise to images then learning to reverse it. Generation = starting from pure noise and "denoising" into a brand-new image guided by your prompt.'},{emoji:'\ud83d\udcac',title:'Prompt engineering',body:'Crafting inputs to get the best outputs: give context, examples (few-shot), and clear instructions. "Chain-of-thought" prompting asks the model to reason step by step.'}],quiz:[{question:'Diffusion models generate images by\u2026',options:['Copying photos','Reversing noise step-by-step','Searching the web','Drawing pixels randomly'],answerIndex:1,explanation:'They learn to denoise \u2014 turning random noise into coherent images.'},{question:'Few-shot prompting means\u2026',options:['Short prompts','Giving examples in the prompt','Firing the model','Using few GPUs'],answerIndex:1,explanation:'Examples in the prompt teach the model the pattern you want.'}]},{id:'w5l2',title:'RAG & Agents',emoji:'\ud83e\udd1d',xp:130,cards:[{emoji:'\ud83d\udcda',title:'RAG',body:'Retrieval-Augmented Generation: fetch relevant documents from a knowledge base (via vector search) and feed them to the LLM. This grounds answers in real data and reduces hallucinations.'},{emoji:'\ud83e\udded',title:'Vector databases',body:'Store embeddings so you can search by MEANING, not keywords. "How do I reset my password" matches "credential recovery steps" even with zero shared words.'},{emoji:'\ud83e\udd16',title:'AI Agents',body:'Agents are LLMs that can plan, use tools (search, code, APIs), observe results, and iterate \u2014 turning language models into autonomous problem solvers.'}],quiz:[{question:'RAG reduces hallucinations by\u2026',options:['Bigger models','Grounding answers in retrieved documents','Slower generation','More GPUs'],answerIndex:1,explanation:'Real retrieved context keeps the model factual.'},{question:'Vector databases enable search by\u2026',options:['Exact keywords','Semantic meaning','File names','Dates'],answerIndex:1,explanation:'Embedding similarity = meaning-based search.'}]}]},{id:'w6',tier:'advanced',title:'Cloud Cert Citadel',subtitle:'Get certification-ready',emoji:'\ud83c\udfc6',lessons:[{id:'w6l1',title:'ML in the Cloud',emoji:'\u2601\ufe0f',xp:130,cards:[{emoji:'\u2601\ufe0f',title:'The big three',body:'AWS SageMaker, Azure Machine Learning, and Google Vertex AI are the managed ML platforms. They handle training infrastructure, deployment, and scaling so you focus on models.'},{emoji:'\ud83e\uddf0',title:'AI services buffet',body:'Clouds offer ready-made AI APIs: vision (Rekognition / Azure Vision / Cloud Vision), speech, translation, and LLMs (Bedrock / Azure OpenAI / Vertex Gemini). Know which service solves which problem \u2014 that\'s 50% of cert exams!'},{emoji:'\ud83d\udcdc',title:'The certifications',body:'AWS AI Practitioner & ML Specialty, Azure AI-900 (Fundamentals) & AI-102 (Engineer), Google Cloud ML Engineer. Fundamentals exams test concepts + service mapping; pro exams add architecture & operations.'}],quiz:[{question:'AWS\'s managed ML platform is\u2026',options:['SageMaker','Vertex AI','Azure ML','Bedrock'],answerIndex:0,explanation:'SageMaker = AWS. Vertex AI = Google. Azure ML = Microsoft.'},{question:'Azure\'s AI fundamentals cert is\u2026',options:['AI-900','AZ-104','ML-500','GCP-ML'],answerIndex:0,explanation:'AI-900 = Azure AI Fundamentals \u2014 the perfect first AI cert.'}]},{id:'w6l2',title:'MLOps & Responsible AI',emoji:'\ud83d\udee1\ufe0f',xp:150,cards:[{emoji:'\ud83d\udd04',title:'MLOps',body:'DevOps for ML: version your data + models, automate training pipelines, monitor for drift (when real-world data shifts away from training data), and retrain automatically.'},{emoji:'\ud83d\udcc8',title:'Model monitoring',body:'Deployed models decay! Data drift, concept drift, and feedback loops degrade accuracy. Cert exams love asking about monitoring and retraining triggers.'},{emoji:'\ud83d\udee1\ufe0f',title:'Responsible AI',body:'Fairness, explainability, privacy, and safety. Know tools like SHAP (explaining predictions), differential privacy, and human-in-the-loop review \u2014 every cloud cert tests responsible AI now.'}],quiz:[{question:'Data drift means\u2026',options:['Data gets deleted','Real-world data shifts from training data','Slow networks','Big datasets'],answerIndex:1,explanation:'When incoming data changes, model accuracy decays \u2014 monitor and retrain!'},{question:'SHAP is used for\u2026',options:['Faster training','Explaining model predictions','Data storage','GPU cooling'],answerIndex:1,explanation:'SHAP values show which features drove each prediction.'},{question:'MLOps includes\u2026',options:['Versioning data & models','Automated pipelines','Drift monitoring','All of the above'],answerIndex:3,explanation:'MLOps = the full lifecycle discipline for production ML.'}]}]},...t.extraWorlds,...n.certWorlds,...a.skillWorlds].sort((t,n)=>l[t.tier]-l[n.tier]).map(t=>Object.assign({},t,{lessons:t.lessons.map(t=>Object.assign({},t,{game:o.lessonGames[t.id]}))})),c=u.reduce((t,n)=>t+n.lessons.length,0)},279,[280,281,282,283]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"extraWorlds",{enumerable:!0,get:function(){return t}});const t=[{id:'wb3',tier:'beginner',title:'History Hills',subtitle:'How we got here',emoji:'\ud83c\udfdb\ufe0f',lessons:[{id:'wb3l1',title:'Birth of AI',emoji:'\ud83e\udd96',xp:50,cards:[{emoji:'\ud83c\udfa9',title:'The Turing Test',body:'In 1950, Alan Turing asked: "Can machines think?" His test: if a machine can chat so well you can\'t tell it from a human, it counts as intelligent. LLMs today are basically taking this test daily!'},{emoji:'\ud83c\udfeb',title:'Dartmouth 1956',body:'The term "Artificial Intelligence" was coined at a summer workshop at Dartmouth College in 1956. The founders thought human-level AI would take one summer. It took a bit longer. \ud83d\ude05'},{emoji:'\u2744\ufe0f',title:'AI Winters',body:'Twice (1970s and late 1980s), hype outran reality, funding dried up, and AI research froze \u2014 the "AI winters". Lesson: real progress needs data, compute, AND realistic expectations.'}],quiz:[{question:'Who proposed the famous "imitation game" test?',options:['Einstein','Alan Turing','Steve Jobs','Ada Lovelace'],answerIndex:1,explanation:'Turing\'s 1950 paper introduced what we now call the Turing Test.'},{question:'An "AI winter" is\u2026',options:['Cold data centers','A funding & interest crash after hype','Winter-only training','A GPU shortage'],answerIndex:1,explanation:'When hype exceeds results, funding freezes \u2014 that happened twice.'}]},{id:'wb3l2',title:'The DL Revolution',emoji:'\ud83c\udf0b',xp:60,cards:[{emoji:'\ud83c\udfae',title:'GPUs changed everything',body:'Graphics cards built for video games turned out to be perfect for neural network math. Cheap parallel compute + internet-scale data = the deep learning boom of the 2010s.'},{emoji:'\ud83c\udfc6',title:'Landmark moments',body:'2012: AlexNet wins ImageNet. 2016: AlphaGo beats the world Go champion. 2017: Transformers invented. 2022: ChatGPT reaches 100M users in 2 months \u2014 fastest app ever at the time.'},{emoji:'\ud83d\udcc8',title:'Scaling laws',body:'Researchers discovered a pattern: bigger models + more data + more compute = predictably better results. That\'s why AI labs race to build gigantic models.'}],quiz:[{question:'What hardware accelerated the deep learning boom?',options:['CPUs','GPUs','Hard drives','Modems'],answerIndex:1,explanation:'GPUs excel at the parallel matrix math neural nets need.'},{question:'AlphaGo\'s 2016 victory was in\u2026',options:['Chess','Poker','Go','Checkers'],answerIndex:2,explanation:'Go was considered impossible for AI for decades \u2014 until AlphaGo.'}]}]},{id:'wb4',tier:'beginner',title:'Everyday AI Bay',subtitle:'AI hiding in plain sight',emoji:'\ud83c\udfd6\ufe0f',lessons:[{id:'wb4l1',title:'Recommenders',emoji:'\ud83c\udfac',xp:60,cards:[{emoji:'\ud83c\udfac',title:'Your personal curator',body:'Netflix, YouTube, Spotify, TikTok \u2014 all powered by recommender systems that learn your taste from what you watch, skip, like, and replay.'},{emoji:'\ud83d\udc65',title:'Collaborative filtering',body:'The classic trick: "people similar to you also liked X". No need to understand the movie \u2014 just find users with matching taste patterns.'},{emoji:'\u26a0\ufe0f',title:'Filter bubbles',body:'Recommenders can trap you in a bubble of similar content. Great for engagement, risky for society \u2014 a hot topic in responsible AI.'}],quiz:[{question:'"Users like you also liked\u2026" is called\u2026',options:['Deep search','Collaborative filtering','Clustering','Regression'],answerIndex:1,explanation:'It recommends based on similar users\' preferences.'},{question:'A downside of recommender systems is\u2026',options:['Filter bubbles','Too much RAM','Slow internet','No downsides'],answerIndex:0,explanation:'Optimizing engagement can narrow what you see.'}]},{id:'wb4l2',title:'Voice & Vision',emoji:'\ud83d\udde3\ufe0f',xp:60,cards:[{emoji:'\ud83d\udde3\ufe0f',title:'Speech recognition',body:'Siri, Alexa, and Google Assistant convert sound waves \u2192 text (speech-to-text), understand intent (NLP), then reply with generated speech (text-to-speech). Three AI systems in one!'},{emoji:'\ud83d\udcf8',title:'Vision in your pocket',body:'Face unlock, portrait mode, Google Lens, photo search for "beach" \u2014 your phone runs vision models locally every day.'},{emoji:'\ud83d\ude97',title:'Self-driving stack',body:'Autonomous cars fuse cameras, radar, and lidar with neural networks for perception, prediction, and planning \u2014 one of the hardest AI problems in the world.'}],quiz:[{question:'A voice assistant\'s pipeline order is\u2026',options:['TTS \u2192 NLP \u2192 STT','STT \u2192 NLP \u2192 TTS','NLP \u2192 STT \u2192 TTS','Random'],answerIndex:1,explanation:'Hear (speech-to-text) \u2192 understand (NLP) \u2192 speak (text-to-speech).'},{question:'Self-driving cars use neural nets for\u2026',options:['Perception','Prediction','Planning','All of the above'],answerIndex:3,explanation:'The whole stack is AI-powered.'}]},{id:'wb4l3',title:'AI Myths Busted',emoji:'\ud83d\udd2e',xp:60,cards:[{emoji:'\ud83e\udd2f',title:'Myth: AI "thinks"',body:'Today\'s AI doesn\'t think or feel \u2014 it finds statistical patterns. A chatbot predicting the next word can seem conscious without being so. Knowing the difference makes you smarter than most headlines!'},{emoji:'\ud83e\uddd1\u200d\ud83d\udcbc',title:'Myth: AI replaces everyone',body:'History says technology transforms jobs more than it erases them. The winning move: humans who master AI tools outperform both plain humans AND plain AI.'},{emoji:'\ud83c\udfaf',title:'Narrow vs General AI',body:'Everything today is narrow AI (great at one task). Artificial General Intelligence (AGI) \u2014 human-level ability across ALL tasks \u2014 doesn\'t exist yet. You\'re learning at the perfect time.'}],quiz:[{question:'All AI systems today are\u2026',options:['Conscious','Narrow AI','AGI','Alive'],answerIndex:1,explanation:'Great at specific tasks, not generally intelligent.'},{question:'The best career strategy in the AI era is\u2026',options:['Ignore AI','Fear AI','Master AI tools','Ban AI'],answerIndex:2,explanation:'Humans + AI beat either alone. That\'s why you\'re here!'}]}]},{i