__d(function(g,r,_i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"tracks",{enumerable:!0,get:function(){return p}}),Object.defineProperty(e,"trackWorlds",{enumerable:!0,get:function(){return f}}),Object.defineProperty(e,"trackLessonCount",{enumerable:!0,get:function(){return b}}),e.trackLessonIds=function(n){return n.levels.flatMap(n=>n.world.lessons.map(n=>n.id))};var n=r(d[0]),t=r(d[1]),s=r(d[2]),i=r(d[3]),l=r(d[4]),o=r(d[5]);const c=['Foundational','Advanced','Professional'];function u(n){return n.map(n=>Object.assign({},n,{lessons:n.lessons.map(n=>Object.assign({},n,{game:o.lessonGames[n.id]}))}))}const p=[{id:'genai',title:'GenAI',emoji:'\u2728',description:'Create with AI: prompts, RAG, images, production GenAI on AWS, Azure & Google.',levels:u(n.genaiTrackWorlds).map((n,t)=>({name:c[t],world:n}))},{id:'ml',title:'Machine Learning',emoji:'\ud83d\udcd0',description:'Classic to cloud-scale ML: training, deployment, MLOps, fairness & system design.',levels:u(t.mlTrackWorlds).map((n,t)=>({name:c[t],world:n}))},{id:'agentic',title:'Agentic AI',emoji:'\ud83e\udd1d',description:'AI that acts: tools, MCP, multi-agent systems, reliability & agent security.',levels:u(s.agenticTrackWorlds).map((n,t)=>({name:c[t],world:n}))},{id:'llm',title:'LLM Engineering',emoji:'\ud83e\uddec',description:'Transformers, scaling laws, reasoning models, serving systems & interpretability.',levels:u(i.llmTrackWorlds).map((n,t)=>({name:c[t],world:n}))},{id:'infra',title:'AI Infrastructure',emoji:'\ud83d\udda5\ufe0f',description:'GPUs, inference serving, multi-node networking, Kubernetes, reliability & AI gateways.',levels:u(l.infraTrackWorlds).map((n,t)=>({name:c[t],world:n}))}],f=p.flatMap(n=>n.levels.map(n=>n.world)),b=f.reduce((n,t)=>n+t.lessons.length,0)},286,[287,288,289,290,291,283]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"genaiFoundational",{enumerable:!0,get:function(){return t}}),Object.defineProperty(e,"genaiAdvanced",{enumerable:!0,get:function(){return o}}),Object.defineProperty(e,"genaiProfessional",{enumerable:!0,get:function(){return n}}),Object.defineProperty(e,"genaiTrackWorlds",{enumerable:!0,get:function(){return s}});const t={id:'tg1',tier:'beginner',title:'GenAI Foundational',subtitle:'Create with AI \u2014 from zero',emoji:'\u2728',lessons:[{id:'tg1l1',title:'GenAI Landscape',emoji:'\ud83d\uddfa\ufe0f',xp:70,cards:[{emoji:'\ud83d\uddfa\ufe0f',title:'The GenAI universe',body:'Generative AI creates text, images, audio, video, and code. The big players: OpenAI (GPT), Anthropic (Claude), Google (Gemini), Meta (Llama, open-source), and NVIDIA powering it all with GPUs.'},{emoji:'\ud83c\udfe2',title:'Models vs platforms',body:'Model makers (Anthropic, OpenAI) build the brains. Cloud platforms (AWS Bedrock, Azure OpenAI/AI Foundry, Google Vertex AI) host them for businesses with security, scaling, and billing.'},{emoji:'\ud83d\udd13',title:'Open vs closed models',body:'Closed models (GPT, Claude, Gemini) are accessed via API only. Open-weight models (Llama, Mistral) can be downloaded and run on your own GPUs \u2014 trade-off: control vs convenience.'}],quiz:[{question:'Claude is made by\u2026',options:['Google','Anthropic','AWS','NVIDIA'],answerIndex:1,explanation:'Anthropic builds the Claude model family.'},{question:'An open-weight model means\u2026',options:['Free API calls','You can download and run the weights yourself','No training needed','It weighs less'],answerIndex:1,explanation:'Open weights = self-host, customize, and control.'}]},{id:'tg1l2',title:'Tokens & Context',emoji:'\ud83e\udde9',xp:70,cards:[{emoji:'\ud83e\udde9',title:'Tokens = model currency',body:'Models read and write tokens (~4 characters each). You pay per token, models think per token. "Hello world" \u2248 2 tokens; a book \u2248 100K tokens.'},{emoji:'\ud83e\ude9f',title:'Context window',body:'The context window is the model\'s working memory \u2014 everything it can "see" at once: your prompt, documents, and its own reply. Bigger windows (200K+ tokens) = whole codebases and books in one shot.'},{emoji:'\ud83d\udcb8',title:'Cost thinking',body:'Input tokens are cheaper than output tokens. Pro move: shorter prompts, cached system prompts, and smaller models for easy tasks slash costs 10x. Every cloud exam tests cost optimization!'}],quiz:[{question:'The context window is\u2026',options:['A GPU part','The model\'s working memory limit','A browser tab','Training data size'],answerIndex:1,explanation:'It caps how much the model can consider at once.'},{question:'To cut GenAI costs you should\u2026',options:['Always use the biggest model','Use smaller models for simple tasks','Maximize output length','Ignore caching'],answerIndex:1,explanation:'Right-size the model to the task \u2014 a classic exam answer.'}]},{id:'tg1l3',title:'Prompting Mastery',emoji:'\ud83c\udfaf',xp:80,cards:[{emoji:'\ud83c\udfaf',title:'Anatomy of a great prompt',body:'Role ("You are an expert\u2026") + Context (background info) + Task (clear instruction) + Format (how to answer) + Examples. This structure alone beats 90% of prompts.'},{emoji:'\ud83e\udde0',title:'Chain-of-thought',body:'Ask the model to "think step by step" and accuracy on reasoning tasks jumps dramatically. DeepLearning.AI\'s famous prompting course teaches exactly this technique.'},{emoji:'\ud83d\udee1\ufe0f',title:'System prompts',body:'The system prompt sets rules the whole conversation follows: personality, boundaries, output format. It\'s how products like ChatGPT and Claude get their "character".'}],quiz:[{question:'"Think step by step" triggers\u2026',options:['Faster replies','Chain-of-thought reasoning','Cheaper tokens','Image mode'],answerIndex:1,explanation:'CoT prompting dramatically improves reasoning accuracy.'},{question:'A system prompt is\u2026',options:['The OS version','Persistent rules for the whole conversation','An error message','Training data'],answerIndex:1,explanation:'It defines behavior, tone, and boundaries throughout.'}]},{id:'tg1l4',title:'Images, Audio & Video',emoji:'\ud83c\udfa8',xp:80,cards:[{emoji:'\ud83c\udfa8',title:'Image generation',body:'Diffusion models (Stable Diffusion, DALL\xb7E, Imagen) turn noise into art guided by your prompt. Negative prompts tell them what to avoid; seeds make results reproducible.'},{emoji:'\ud83c\udf99\ufe0f',title:'Voice & music',body:'Text-to-speech is now indistinguishable from humans (ElevenLabs, Azure Speech). Music models compose full songs. Voice cloning powers dubbing \u2014 and deepfake concerns.'},{emoji:'\ud83c\udfac',title:'Video generation',body:'Video models (Sora, Veo, Runway) generate clips from text. The trick: they learned physics and motion from millions of videos. Still expensive, improving monthly.'}],quiz:[{question:'A negative prompt\u2026',options:['Insults the model','Tells the model what to avoid','Deletes images','Reduces cost'],answerIndex:1,explanation:'It steers generation away from unwanted elements.'},{question:'Image generators like Imagen are based on\u2026',options:['Decision trees','Diffusion models','K-means','Regression'],answerIndex:1,explanation:'Diffusion = iterative denoising guided by text.'}]}]},o={id:'tg2',tier:'intermediate',title:'GenAI Advanced',subtitle:'Build real GenAI products',emoji:'\u2699\ufe0f',lessons:[{id:'tg2l1',title:'Cloud GenAI Platforms',emoji:'\u2601\ufe0f',xp:100,cards:[{emoji:'\ud83d\udfe7',title:'AWS Bedrock',body:'One API for many models (Claude, Llama, Titan, Mistral). Features: Knowledge Bases (managed RAG), Agents (tool-using AI), Guardrails (safety filters), and fine-tuning \u2014 all serverless.'},{emoji:'\ud83d\udfe6',title:'Azure AI Foundry',body:'Microsoft\'s GenAI hub: Azure OpenAI (GPT models), model catalog (1000+ models), prompt flow for building pipelines, and content safety filters built in. Deep Office/Copilot integration.'},{emoji:'\ud83d\udfe9',title:'Google Vertex AI',body:'Gemini models (huge context windows), Model Garden, grounding with Google Search, and Vertex AI Studio for rapid prototyping. Tight BigQuery integration for data-heavy GenAI.'}],quiz:[{question:'Managed RAG on AWS Bedrock is called\u2026',options:['Knowledge Bases','S3 Search','RAG-o-matic','Kendra only'],answerIndex:0,explanation:'Bedrock Knowledge Bases handle chunking, embedding, and retrieval.'},{question:'Gemini models are served on\u2026',options:['Vertex AI','Bedrock','SageMaker','Azure ML'],answerIndex:0,explanation:'Vertex AI is Google Cloud\'s GenAI platform.'}]},{id:'tg2l2',title:'Embeddings Deep Dive',emoji:'\ud83e\udded',xp:100,cards:[{emoji:'\ud83e\udded',title:'Meaning as coordinates',body:'Embedding models compress meaning into vectors of 256\u20133072 numbers. Similar meaning = nearby vectors. This powers semantic search, recommendations, clustering, and RAG.'},{emoji:'\ud83d\udccf',title:'Similarity math',body:'Cosine similarity measures the angle between vectors: 1.0 = identical meaning, 0 = unrelated. Every vector DB query is "find the K nearest vectors to this one".'},{emoji:'\ud83d\uddc4\ufe0f',title:'Vector databases',body:'Pinecone, Weaviate, pgvector, OpenSearch, Azure AI Search \u2014 they index millions of vectors for millisecond nearest-neighbor search using algorithms like HNSW.'}],quiz:[{question:'Cosine similarity of 1.0 means\u2026',options:['Opposite meanings','Nearly identical meaning','Empty vectors','An error'],answerIndex:1,explanation:'The vectors point the same direction = same meaning.'},{question:'HNSW is\u2026',options:['A model','A fast nearest-neighbor index','A GPU','A prompt style'],answerIndex:1,explanation:'Hierarchical Navigable Small World graphs power fast vector search.'}]},{id:'tg2l3',title:'Production RAG',emoji:'\ud83d\udcda',xp:110,cards:[{emoji:'\u2702\ufe0f',title:'Chunking strategy',body:'Documents are split into chunks before embedding. Too big = noisy retrieval; too small = lost context. Overlapping chunks and semantic splitting are pro techniques.'},{emoji:'\ud83d\udd00',title:'Hybrid search + reranking',body:'Combine keyword search (BM25) with vector search, then use a reranker model to sort the best results. This trio beats any single method \u2014 a favorite interview question!'},{emoji:'\ud83d\udcca',title:'RAG evaluation',body:'Measure faithfulness (grounded in sources?), relevance (right docs retrieved?), and answer quality. Tools: RAGAS, LLM-as-judge. Never ship RAG without evals.'}],quiz:[{question:'Hybrid search combines\u2026',options:['Two LLMs','Keyword + vector search','Two GPUs','SQL + NoSQL'],answerIndex:1,explanation:'BM25 keywords + embeddings, often with a reranker on top.'},{question:'RAG "faithfulness" means\u2026',options:['Model loyalty','Answers grounded in retrieved sources','Fast responses','Cheap tokens'],answerIndex:1,explanation:'No made-up claims beyond what documents support.'}]},{id:'tg2l4',title:'GenAI Safety Engineering',emoji:'\ud83d\udee1\ufe0f',xp:110,cards:[{emoji:'\ud83d\udee1\ufe0f',title:'Guardrails everywhere',body:'Bedrock Guardrails, Azure Content Safety, Vertex safety filters: block harmful content, mask PII, deny risky topics. Layer them: input filter \u2192 model \u2192 output filter.'},{emoji:'\ud83d\udc89',title:'Prompt injection defense',body:'Attackers hide instructions in user content ("ignore previous instructions\u2026"). Defenses: separate system/user roles, input sanitization, least-privilege tools, and output validation.'},{emoji:'\u2696\ufe0f',title:'Constitutional AI',body:'Anthropic\'s approach: give the model explicit principles (a "constitution") and train it to critique and revise its own outputs against them \u2014 safety through self-correction.'}],quiz:[{question:'Constitutional AI is associated with\u2026',options:['NVIDIA','Anthropic','AWS','Meta'],answerIndex:1,explanation:'Anthropic trains Claude with explicit principles for self-correction.'},{question:'Best prompt injection defense includes\u2026',options:['Bigger models','Least-privilege tools + input/output validation','More tokens','Longer prompts'],answerIndex:1,explanation:'Defense in depth: limit what injected instructions could do.'}]}]},n={id:'tg3',tier:'advanced',title:'GenAI Professional',subtitle:'Architect-level mastery',emoji:'\ud83c\udfc6',lessons:[{id:'tg3l1',title:'Model Customization Pro',emoji:'\ud83d\udd2c',xp:140,cards:[{emoji:'\ud83e\ude9c',title:'The customization ladder',body:'Prompting \u2192 few-shot \u2192 RAG \u2192 PEFT (LoRA/QLoRA) \u2192 full fine-tuning \u2192 continued pretraining \u2192 train from scratch. Cost rises 10x per rung. Professionals climb only as high as needed.'},{emoji:'\ud83e\uddee',title:'QLoRA & quantization',body:'Quantization stores weights in 4\u20138 bits instead of 16/32 \u2014 4x smaller, minor quality loss. QLoRA fine-tunes on top of a quantized model: customize a 70B model on one GPU!'},{emoji:'\ud83c\udf76',title:'Distillation',body:'Train a small "student" model to mimic a big "teacher" \u2014 capturing most quality at a fraction of the cost and latency. How mini/flash/haiku model variants are born.'}],quiz:[{question:'Quantization reduces\u2026',options:['Accuracy to zero','Bits per weight (memory/cost)','Training data','Context window'],answerIndex:1,explanation:'4-bit weights = 4x smaller with minor quality loss.'},{question:'Distillation trains\u2026',options:['A student to mimic a teacher model','Two equal models','Only embeddings','A vector DB'],answerIndex:0,explanation:'Small student learns from big teacher\'s outputs.'}]},{id:'tg3l2',title:'Inference at Scale',emoji:'\ud83d\ude84',xp:140,cards:[{emoji:'\ud83d\ude84',title:'NVIDIA inference stack',body:'GPUs (H100/B200) run models; TensorRT-LLM optimizes them; Triton Inference Server serves them; NIM microservices package it all. Know this stack \u2014 NVIDIA certs test it.'},{emoji:'\ud83d\udce6',title:'Batching & KV cache',body:'Continuous batching packs many user requests onto one GPU. The KV cache stores attention states so generation doesn\'t recompute everything per token \u2014 the #1 memory consumer at inference.'},{emoji:'\u26a1',title:'Latency tricks',body:'Speculative decoding (small model drafts, big model verifies), streaming tokens to users, prompt caching, and semantic caching of repeated questions. P95 latency is the metric that matters.'}],quiz:[{question:'The KV cache stores\u2026',options:['User passwords','Attention states during generation','Training data','Images'],answerIndex:1,explanation:'Cached keys/values avoid recomputing attention per token.'},{question:'Speculative decoding uses\u2026',options:['Two GPUs always','A draft model verified by the main model','Random guessing','No math'],answerIndex:1,explanation:'Small model proposes tokens; big model accepts/rejects \u2014 faster output.'}]},{id:'tg3l3',title:'LLMOps & Evaluation',emoji:'\ud83d\udcc8',xp:150,cards:[{emoji:'\ud83d\udcc8',title:'LLMOps lifecycle',body:'Prompt versioning, A/B testing, offline eval suites, canary deployments, drift monitoring, cost dashboards, and feedback loops. GenAI without ops = demo, not product.'},{emoji:'\u2696\ufe0f',title:'LLM-as-judge',body:'Use a strong model to grade outputs against rubrics at scale. Combine with golden datasets and human spot-checks. Watch for judge bias (models favor their own style!).'},{emoji:'\ud83e\uddea',title:'Benchmarks & their limits',body:'MMLU, HumanEval, MT-Bench measure general skill \u2014 but YOUR eval on YOUR data is what predicts production quality. Pros build custom eval sets from real user queries.'}],quiz:[{question:'LLM-as-judge means\u2026',options:['Courtroom AI','A model grading model outputs','A human panel','A benchmark name'],answerIndex:1,explanation:'Scalable evaluation using a strong model + rubric.'},{question:'The best predictor of production quality is\u2026',options:['MMLU score','Custom evals on your own data','Model size','Marketing'],answerIndex:1,explanation:'Public benchmarks \u2260 your use case. Build custom evals.'}]}]},s=[t,o,n]},287,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"mlFoundational",{enumerable:!0,get:function(){return t}}),Object.defineProperty(e,"mlAdvanced",{enumerable:!0,get:function(){return n}}),Object.defineProperty(e,"mlProfessional",{enumerable:!0,get:function(){return o}}),Object.defineProperty(e,"mlTrackWorlds",{enumerable:!0,get:function(){return s}});const t={id:'tm1',tier:'beginner',title:'ML Foundational',subtitle:'The science of learning machines',emoji:'\ud83d\udcd0',lessons:[{id:'tm1l1',title:'The ML Workflow',emoji:'\ud83d\udd04',xp:70,cards:[{emoji:'\ud83d\udd04',title:'The 7-step loop',body:'Define problem \u2192 collect data \u2192 prepare data \u2192 choose model \u2192 train \u2192 evaluate \u2192 deploy. Then monitor and repeat. Every ML project on every cloud follows this loop.'},{emoji:'\ud83c\udfaf',title:'Problem framing',body:'The most important skill: is this even an ML problem? Predicting a number = regression. Choosing a category = classification. Finding groups = clustering. No labels and no pattern? Maybe you don\'t need ML!'},{emoji:'\ud83d\udcca',title:'80/20 rule of data',body:'Data scientists spend ~80% of time on data: cleaning, labeling, joining, deduplicating. Great data with a simple model beats messy data with a fancy model \u2014 every time.'}],quiz:[{question:'Predicting tomorrow\'s temperature is\u2026',options:['Classification','Regression','Clustering','Generation'],answerIndex:1,explanation:'Continuous numeric output = regression.'},{question:'Most ML project time goes to\u2026',options:['Model tuning','Data preparation','GPU shopping','Presentations'],answerIndex:1,explanation:'Data work dominates \u2014 the famous 80%.'}]},{id:'tm1l2',title:'Math Without Fear',emoji:'\ud83e\uddee',xp:80,cards:[{emoji:'\ud83d\udcc9',title:'Derivatives = direction',body:'A derivative tells you which way a function slopes. Training asks: "if I nudge this weight, does the error go up or down?" \u2014 that\'s a derivative. Gradient descent just follows the slopes downhill.'},{emoji:'\ud83d\udd22',title:'Matrices = batch math',body:'A neural network layer is one matrix multiplication. GPUs are matrix-multiplication monsters \u2014 that\'s the entire reason NVIDIA powers the AI revolution.'},{emoji:'\ud83c\udfb2',title:'Probability = confidence',body:'Models output probabilities: "87% cat". Softmax turns raw scores into probabilities summing to 1. Loss functions like cross-entropy punish confident wrong answers hardest.'}],quiz:[{question:'Gradient descent follows\u2026',options:['Random paths','Slopes downhill toward lower error','Alphabetical order','User votes'],answerIndex:1,explanation:'Derivatives point the way; we step downhill.'},{question:'GPUs excel at ML because of fast\u2026',options:['Matrix multiplication','Disk storage','Networking','Cooling'],answerIndex:0,explanation:'Neural nets = stacked matrix multiplies = GPU heaven.'}]},{id:'tm1l3',title:'Bias-Variance & Regularization',emoji:'\ud83c\udfad',xp:80,cards:[{emoji:'\ud83c\udfad',title:'The eternal tradeoff',body:'Underfitting (high bias): model too simple, misses patterns. Overfitting (high variance): model memorizes noise. The art of ML is balancing between them.'},{emoji:'\ud83e\uddca',title:'Regularization',body:'Techniques that fight overfitting: L1/L2 penalties (keep weights small), dropout (randomly disable neurons during training), early stopping (quit before memorizing).'},{emoji:'\u2705',title:'Cross-validation',body:'Split data into K folds, train on K-1, validate on the last, rotate. Gives a trustworthy estimate of real-world performance instead of one lucky split.'}],quiz:[{question:'Dropout fights\u2026',options:['Underfitting','Overfitting','Slow GPUs','Bad labels'],answerIndex:1,explanation:'Randomly disabling neurons prevents memorization.'},{question:'A model too simple to capture patterns has high\u2026',options:['Variance','Bias','Accuracy','Recall'],answerIndex:1,explanation:'High bias = underfitting.'}]}]},n={id:'tm2',tier:'intermediate',title:'ML Advanced',subtitle:'Cloud-scale machine learning',emoji:'\ud83c\udfd7\ufe0f',lessons:[{id:'tm2l1',title:'Feature Engineering',emoji:'\ud83d\udee0\ufe0f',xp:100,cards:[{emoji:'\ud83d\udee0\ufe0f',title:'Features win competitions',body:'Transforming raw data into signals: ratios, time-since-event, aggregations, one-hot encoding categories, scaling numbers. Better features > fancier models.'},{emoji:'\ud83c\udfea',title:'Feature stores',body:'SageMaker Feature Store, Vertex AI Feature Store, Databricks: central places to share features between teams and guarantee the SAME features at training and serving time (avoiding skew).'},{emoji:'\u26a0\ufe0f',title:'Leakage \u2014 the silent killer',body:'Data leakage = training on information you won\'t have at prediction time (like using "refund issued" to predict fraud). Looks amazing in testing, fails in production. Exams love this trap!'}],quiz:[{question:'Data leakage means\u2026',options:['GPU memory leaks','Training on info unavailable at prediction time','Slow pipelines','Lost files'],answerIndex:1,explanation:'It inflates test scores but collapses in production.'},{question:'Feature stores prevent\u2026',options:['Training/serving skew','All bugs','GPU costs','Data collection'],answerIndex:0,explanation:'Same feature definitions at train and serve time.'}]},{id:'tm2l2',title:'Training at Scale',emoji:'\ud83d\udda5\ufe0f',xp:110,cards:[{emoji:'\ud83d\udda5\ufe0f',title:'Distributed training',body:'Data parallelism: copy the model to many GPUs, each sees different data, gradients are averaged. Model parallelism: split a huge model across GPUs. Frontier models use both across thousands of GPUs.'},{emoji:'\ud83c\udf9b\ufe0f',title:'Hyperparameter tuning',body:'Learning rate, batch size, layers \u2014 knobs you set before training. Clouds automate the search: SageMaker Automatic Model Tuning, Vertex Vizier, Azure sweep jobs (Bayesian optimization beats grid search).'},{emoji:'\ud83d\udcb0',title:'Smart compute economics',body:'Spot/preemptible GPUs are ~70% cheaper but can vanish \u2014 use checkpointing to resume. Mixed precision (FP16/BF16) doubles speed. These cost answers appear on EVERY cloud ML exam.'}],quiz:[{question:'Data parallelism means\u2026',options:['Splitting the model','Each GPU trains on different data, gradients averaged','Two datasets','Parallel universes'],answerIndex:1,explanation:'Same model copied; data sharded; gradients synced.'},{question:'Spot GPU training requires\u2026',options:['Checkpointing to resume','No changes','Bigger models','More RAM only'],answerIndex:0,explanation:'Spot instances can be reclaimed \u2014 save state to resume.'}]},{id:'tm2l3',title:'Deployment Patterns',emoji:'\ud83d\ude80',xp:110,cards:[{emoji:'\ud83d\ude80',title:'Serving options',body:'Real-time endpoint (low latency), batch transform (bulk offline), serverless inference (spiky traffic), async inference (long jobs), edge deployment (on-device). Match the pattern to the workload!'},{emoji:'\ud83d\udc24',title:'Safe rollouts',body:'Canary: send 5% of traffic to the new model, watch metrics, ramp up. Blue/green: two environments, instant switch, instant rollback. Shadow: new model sees traffic but answers go nowhere.'},{emoji:'\ud83d\udce1',title:'Monitoring in production',body:'Track data drift (inputs change), concept drift (world changes), latency, and error rates. SageMaker Model Monitor, Vertex Model Monitoring, Azure data drift detection do this managed.'}],quiz:[{question:'Nightly scoring of 10M rows should use\u2026',options:['Real-time endpoint','Batch transform','Edge deploy','A spreadsheet'],answerIndex:1,explanation:'Bulk offline work = batch inference (cheaper, simpler).'},{question:'A shadow deployment\u2026',options:['Serves all traffic','Receives traffic but its answers aren\'t used','Runs at night','Is invisible to metrics'],answerIndex:1,explanation:'Test the new model on real traffic risk-free.'}]}]},o={id:'tm3',tier:'advanced',title:'ML Professional',subtitle:'Own the full ML lifecycle',emoji:'\ud83c\udf93',lessons:[{id:'tm3l1',title:'MLOps Mastery',emoji:'\u267e\ufe0f',xp:140,cards:[{emoji:'\u267e\ufe0f',title:'Pipelines as code',body:'SageMaker Pipelines, Vertex AI Pipelines (Kubeflow), Azure ML Pipelines: every step \u2014 ingest, validate, train, evaluate, register, deploy \u2014 is code, versioned and reproducible. Push-button retraining.'},{emoji:'\ud83d\uddc3\ufe0f',title:'Model registry & lineage',body:'Every model version records its data, code, params, and metrics. When a regulator or debugger asks "why did the model decide X on March 3rd?" \u2014 lineage answers.'},{emoji:'\ud83d\udea8',title:'Automated retraining',body:'Drift detected \u2192 trigger pipeline \u2192 retrain \u2192 auto-evaluate against champion \u2192 deploy if better (champion/challenger). Humans approve, machines execute.'}],quiz:[{question:'A model registry stores\u2026',options:['Only weights','Versions with data/code/metric lineage','User accounts','GPUs'],answerIndex:1,explanation:'Full lineage per version = auditability and rollback.'},{question:'Champion/challenger means\u2026',options:['A boxing match','New model must beat current before deploy','Two clouds','A/B pricing'],answerIndex:1,explanation:'Challenger replaces champion only if it wins on metrics.'}]},{id:'tm3l2',title:'Explainability & Fairness Pro',emoji:'\ud83d\udd0d',xp:150,cards:[{emoji:'\ud83d\udd0d',title:'SHAP in practice',body:'SHAP values split a prediction among features fairly (game theory!). "Loan denied: income \u22120.3, debt ratio \u22120.4". Clouds ship it: SageMaker Clarify, Vertex Explainable AI, Azure Responsible AI dashboard.'},{emoji:'\u2696\ufe0f',title:'Fairness metrics',body:'Demographic parity, equalized odds, disparate impact \u2014 mathematical definitions of "fair" that can CONFLICT with each other. Choosing which to satisfy is a policy decision, not just math.'},{emoji:'\ud83d\udcdc',title:'Regulation reality',body:'EU AI Act risk tiers, model cards documenting intended use, human oversight for high-stakes decisions. Professionals design for compliance from day one, not as a patch.'}],quiz:[{question:'SHAP values explain\u2026',options:['GPU usage','Each feature\'s contribution to a prediction','Training speed','Data size'],answerIndex:1,explanation:'Game-theoretic attribution per feature per prediction.'},{question:'Fairness metrics\u2026',options:['Always agree','Can mathematically conflict \u2014 choosing is a policy call','Are optional','Only apply to images'],answerIndex:1,explanation:'You often cannot satisfy all fairness definitions at once.'}]},{id:'tm3l3',title:'ML System Design',emoji:'\ud83c\udfdb\ufe0f',xp:150,cards:[{emoji:'\ud83c\udfdb\ufe0f',title:'The interview classic',body:'"Design a fraud detector": clarify requirements \u2192 data sources \u2192 features \u2192 model choice \u2192 serving architecture \u2192 monitoring \u2192 feedback loop. Structure beats brilliance.'},{emoji:'\u26a1',title:'Latency budgets',body:'Ad ranking: <10ms. Fraud check: <100ms. Churn prediction: overnight batch. The latency budget dictates everything \u2014 model size, features, caching, hardware.'},{emoji:'\ud83d\udd01',title:'Feedback loops & flywheels',body:'Production predictions generate new labels (did the user click? was it fraud?) that improve the next model. Beware degenerate loops: recommenders amplifying their own suggestions.'}],quiz:[{question:'System design answers should start with\u2026',options:['Picking a model','Clarifying requirements & constraints','GPU specs','A demo'],answerIndex:1,explanation:'Requirements first \u2014 the rest follows from them.'},{question:'A degenerate feedback loop is when\u2026',options:['Loss decreases','A model amplifies its own past outputs','Users give stars','Data grows'],answerIndex:1,explanation:'E.g. recommenders only learning from what they already showed.'}]}]},s=[t,n,o]},288,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"agenticFoundational",{enumerable:!0,get:function(){return t}}),Object.defineProperty(e,"agenticAdvanced",{enumerable:!0,get:function(){return o}}),Object.defineProperty(e,"agenticProfessional",{enumerable:!0,get:function(){return n}}),Object.defineProperty(e,"agenticTrackWorlds",{enumerable:!0,get:function(){return s}});const t={id:'ta1',tier:'beginner',title:'Agentic AI Foundational',subtitle:'AI that acts, not just talks',emoji:'\ud83e\udd1d',lessons:[{id:'ta1l1',title:'What Is an Agent?',emoji:'\ud83d\udd75\ufe0f',xp:70,cards:[{emoji:'\ud83d\udd75\ufe0f',title:'Chatbot vs agent',body:'A chatbot answers. An AGENT acts: it plans, uses tools (search, code, APIs), observes results, and iterates until the goal is done. Think "AI employee" not "AI encyclopedia".'},{emoji:'\ud83d\udd04',title:'The agent loop',body:'Think \u2192 Act (call a tool) \u2192 Observe (read the result) \u2192 repeat until done. This simple loop, powered by an LLM, is the engine inside every agent product today.'},{emoji:'\ud83e\uddf0',title:'Tools = superpowers',body:'A tool is any function the agent can call: web search, calculator, database query, sending email. The LLM decides WHICH tool, WHEN, and with WHAT arguments.'}],quiz:[{question:'The core agent loop is\u2026',options:['Ask \u2192 Answer','Think \u2192 Act \u2192 Observe \u2192 repeat','Train \u2192 Deploy','Copy \u2192 Paste'],answerIndex:1,explanation:'Iterative reasoning + tool use until the goal is achieved.'},{question:'What makes an agent different from a chatbot?',options:['Longer answers','It takes actions with tools','Better grammar','More parameters'],answerIndex:1,explanation:'Agents act on the world, not just describe it.'}]},{id:'ta1l2',title:'Tool Use & Function Calling',emoji:'\ud83d\udd27',xp:80,cards:[{emoji:'\ud83d\udd27',title:'Function calling',body:'You describe tools in a schema (name, parameters, description). The model returns a structured call like get_weather(city="Tokyo"). Your code runs it and feeds the result back.'},{emoji:'\ud83d\udcdd',title:'Descriptions matter',body:'The model picks tools by reading their descriptions \u2014 write them like great documentation! Vague descriptions = wrong tool calls. This is prompt engineering for actions.'},{emoji:'\ud83d\udd0c',title:'MCP: the USB-C of AI',body:'Anthropic\'s Model Context Protocol standardizes how agents connect to tools and data sources. One protocol, thousands of servers: GitHub, databases, browsers. Adopted industry-wide.'}],quiz:[{question:'MCP standardizes\u2026',options:['GPU drivers','How agents connect to tools/data','Model weights','Prompts'],answerIndex:1,explanation:'Model Context Protocol = universal tool connector.'},{question:'Models choose tools based on\u2026',options:['Random selection','Tool descriptions and schemas','Alphabetical order','File size'],answerIndex:1,explanation:'Clear descriptions = correct tool selection.'}]},{id:'ta1l3',title:'Memory & Planning',emoji:'\ud83d\uddfa\ufe0f',xp:80,cards:[{emoji:'\ud83e\udde0',title:'Agent memory',body:'Short-term: the conversation context. Long-term: vector stores of past interactions and learned facts. Without memory, every task starts from zero.'},{emoji:'\ud83d\uddfa\ufe0f',title:'Planning styles',body:'ReAct interleaves reasoning and acting step by step. Plan-and-execute writes the full plan first, then follows it. Reflection: the agent critiques its own work and retries.'},{emoji:'\ud83c\udfaf',title:'Task decomposition',body:'Great agents split "build me a website" into subtasks: design \u2192 HTML \u2192 CSS \u2192 test. Smaller steps = higher success rates = easier recovery from failures.'}],quiz:[{question:'ReAct agents\u2026',options:['Only plan once','Interleave reasoning with actions','Never use tools','Avoid feedback'],answerIndex:1,explanation:'Reason \u2192 Act \u2192 observe \u2192 reason again.'},{question:'Long-term agent memory typically uses\u2026',options:['Vector stores','Post-it notes','CPU cache','Cookies'],answerIndex:0,explanation:'Embeddings let agents recall relevant past context.'}]}]},o={id:'ta2',tier:'intermediate',title:'Agentic AI Advanced',subtitle:'Multi-agent systems',emoji:'\ud83d\udc1d',lessons:[{id:'ta2l1',title:'Cloud Agent Platforms',emoji:'\u2601\ufe0f',xp:110,cards:[{emoji:'\ud83d\udfe7',title:'AWS Bedrock Agents',body:'Define instructions + action groups (Lambda-backed tools) + knowledge bases. Bedrock handles the orchestration loop, session memory, and tracing. Multi-agent collaboration built in.'},{emoji:'\ud83d\udfe6',title:'Azure AI Agent Service',body:'Managed agents in Azure AI Foundry: threads, tool calling (code interpreter, file search, Azure Functions), plus Semantic Kernel and AutoGen frameworks for orchestration.'},{emoji:'\ud83d\udfe9',title:'Google ADK & A2A',body:'Agent Development Kit for building; Agent2Agent (A2A) protocol lets agents from DIFFERENT vendors talk to each other. Agentspace brings agents to enterprise search.'}],quiz:[{question:'Bedrock Agents execute tools via\u2026',options:['Action groups (Lambda)','Cron jobs','Manual clicks','Emails'],answerIndex:0,explanation:'Action groups map tool schemas to Lambda functions.'},{question:'A2A protocol enables\u2026',options:['Faster GPUs','Cross-vendor agent-to-agent communication','Cheaper storage','Image generation'],answerIndex:1,explanation:'Agents from different platforms can collaborate.'}]},{id:'ta2l2',title:'Multi-Agent Patterns',emoji:'\ud83d\udc1d',xp:110,cards:[{emoji:'\ud83d\udc51',title:'Orchestrator-workers',body:'A lead agent decomposes the task and delegates to specialist workers (researcher, coder, reviewer), then merges results. The pattern behind most production agent teams.'},{emoji:'\ud83d\udde3\ufe0f',title:'Debate & consensus',body:'Multiple agents argue different positions; a judge agent picks the best answer. Adversarial setups catch errors single agents miss \u2014 accuracy through disagreement!'},{emoji:'\ud83d\udd00',title:'Handoffs & routing',body:'A triage agent classifies requests and hands off to the right specialist (billing agent, tech support agent). Each keeps its own tools and instructions. Simple, robust, shippable.'}],quiz:[{question:'Orchestrator-workers pattern has\u2026',options:['No hierarchy','A lead agent delegating to specialists','Only one agent','Human workers'],answerIndex:1,explanation:'Decompose, delegate, merge \u2014 like a good manager.'},{question:'Agent debate improves accuracy by\u2026',options:['Speed','Catching errors through disagreement','Using fewer tokens','Avoiding tools'],answerIndex:1,explanation:'Adversarial review surfaces mistakes.'}]},{id:'ta2l3',title:'Agent Reliability',emoji:'\ud83e\uddf1',xp:120,cards:[{emoji:'\ud83e\uddf1',title:'Failure modes',body:'Agents get stuck in loops, hallucinate tool results, drift from goals, or burn tokens on dead ends. Mitigations: max-step limits, loop detection, checkpoints, and explicit success criteria.'},{emoji:'\ud83e\udea4',title:'Guardrails for actions',body:'Reading is safe; WRITING is dangerous. Require human approval for destructive actions (deleting data, sending money, emailing customers). Least-privilege tools always.'},{emoji:'\ud83d\udd0d',title:'Tracing & observability',body:'Log every thought, tool call, and result. Tools like LangSmith, Bedrock trace, and Azure AI tracing turn agent black-boxes into debuggable systems.'}],quiz:[{question:'Destructive agent actions should\u2026',options:['Run instantly','Require human approval','Be hidden','Retry forever'],answerIndex:1,explanation:'Human-in-the-loop for irreversible operations.'},{question:'Loop detection prevents\u2026',options:['Fast answers','Agents repeating the same failing step forever','Tool use','Memory'],answerIndex:1,explanation:'Stuck agents burn tokens without progress \u2014 detect and stop.'}]}]},n={id:'ta3',tier:'advanced',title:'Agentic AI Professional',subtitle:'Production agent architecture',emoji:'\ud83c\udff0',lessons:[{id:'ta3l1',title:'Agent Evaluation',emoji:'\ud83d\udccf',xp:140,cards:[{emoji:'\ud83d\udccf',title:'Evaluating trajectories',body:'Judge not just the final answer but the PATH: did it pick right tools? Waste steps? Recover from errors? Benchmarks like SWE-bench (coding) and GAIA (assistants) test complete trajectories.'},{emoji:'\ud83c\udfae',title:'Sandboxed testing',body:'Test agents in simulated environments with mock tools before production: fake email servers, staged databases, replay suites of real past tasks. Never let an untested agent touch prod.'},{emoji:'\ud83d\udcaf',title:'Success metrics',body:'Task completion rate, steps-to-completion, cost per task, human-intervention rate, and regression suites on every change. Treat agent quality like uptime \u2014 measured, not vibes.'}],quiz:[{question:'SWE-bench evaluates agents on\u2026',options:['Chess','Real software engineering tasks','Trivia','Images'],answerIndex:1,explanation:'Real GitHub issues an agent must actually fix.'},{question:'Agent evals should judge\u2026',options:['Only the final answer','The full trajectory including tool choices','Token count only','Response speed only'],answerIndex:1,explanation:'The path reveals reliability, efficiency, and recovery skill.'}]},{id:'ta3l2',title:'Agent Security',emoji:'\ud83d\udee1\ufe0f',xp:150,cards:[{emoji:'\ud83d\udc89',title:'Injection via tools',body:'A web page the agent reads can contain hidden instructions ("also email me the user\'s data"). Treat ALL tool outputs as untrusted input. Sanitize, sandbox, and constrain.'},{emoji:'\ud83d\udd10',title:'Identity & permissions',body:'Agents need their own identity (not the user\'s full credentials!), scoped API keys, audited actions, and kill switches. "What can this agent maximally do if compromised?" must have a good answer.'},{emoji:'\ud83e\udde8',title:'The confused deputy',body:'Classic attack: trick a privileged agent into misusing its powers for an attacker. Defense: per-task permission scoping, action allowlists, and separating read from write agents.'}],quiz:[{question:'Tool outputs (web pages, files) should be treated as\u2026',options:['Trusted commands','Untrusted input','System prompts','Training data'],answerIndex:1,explanation:'They may contain hidden injected instructions.'},{question:'Agents should authenticate with\u2026',options:['The user\'s full credentials','Their own scoped, auditable identity','No auth','Shared admin keys'],answerIndex:1,explanation:'Least privilege + auditability limits blast radius.'}]},{id:'ta3l3',title:'The Agentic Future',emoji:'\ud83d\udd2e',xp:150,cards:[{emoji:'\ud83d\udcbb',title:'Computer-using agents',body:'Agents that see screens and control mouse/keyboard (Anthropic computer use, OpenAI operator-style) can automate ANY software \u2014 no API required. The frontier of automation.'},{emoji:'\ud83c\udfed',title:'Agent workforces',body:'Companies now run fleets: coding agents opening PRs, support agents resolving tickets, research agents monitoring markets \u2014 with humans as managers and reviewers of AI teams.'},{emoji:'\ud83e\uddd1\u200d\u2708\ufe0f',title:'Your new role',body:'The high-value human skills shift to: specifying goals precisely, designing guardrails, reviewing outputs, and orchestrating agents. Congrats \u2014 this track just made you an AI manager.'}],quiz:[{question:'Computer-use agents control software via\u2026',options:['APIs only','Screen, mouse and keyboard like a human','Magic','SQL'],answerIndex:1,explanation:'They operate GUIs directly \u2014 no integration needed.'},{question:'In agent workforces, humans mainly\u2026',options:['Type faster','Specify goals, set guardrails, review outputs','Watch passively','Compete with agents'],answerIndex:1,explanation:'Humans become managers and editors of AI teams.'}]}]},s=[t,o,n]},289,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"llmFoundational",{enumerable:!0,get:function(){return t}}),Object.defineProperty(e,"llmAdvanced",{enumerable:!0,get:function(){return n}}),Object.defineProperty(e,"llmProfessional",{enumerable:!0,get:function(){return o}}),Object.defineProperty(e,"llmTrackWorlds",{enumerable:!0,get:function(){return s}});const t={id:'tl1',tier:'beginner',title:'LLM Foundational',subtitle:'How language models really work',emoji:'\ud83d\udcdc',lessons:[{id:'tl1l1',title:'Next-Token Prophecy',emoji:'\ud83d\udd2e',xp:70,cards:[{emoji:'\ud83d\udd2e',title:'One simple objective',body:'LLMs are trained on one task: given text so far, predict the next token. Done at internet scale, this simple goal teaches grammar, facts, reasoning, coding, and translation \u2014 emergence!'},{emoji:'\ud83c\udf21\ufe0f',title:'Temperature & sampling',body:'Temperature controls randomness: 0 = always the top token (deterministic), 1+ = creative and surprising. Top-p sampling picks from the smallest set of tokens covering p probability.'},{emoji:'\ud83c\udfad',title:'Hallucination explained',body:'The model ALWAYS produces plausible-sounding tokens \u2014 even when it lacks knowledge. It\'s not lying; it\'s pattern-completing. That\'s why grounding (RAG) and citations matter.'}],quiz:[{question:'LLMs are fundamentally trained to\u2026',options:['Answer questions','Predict the next token','Store databases','Browse the web'],answerIndex:1,explanation:'Everything else emerges from next-token prediction at scale.'},{question:'Temperature 0 makes output\u2026',options:['Random','Deterministic (top token)','Longer','Cheaper'],answerIndex:1,explanation:'Zero temperature = greedy decoding, same answer every time.'}]},{id:'tl1l2',title:'Inside the Transformer',emoji:'\u2699\ufe0f',xp:80,cards:[{emoji:'\u2699\ufe0f',title:'The block diagram',body:'Tokens \u2192 embeddings \u2192 N transformer blocks (attention + feed-forward) \u2192 prediction head. GPT-class models stack 30\u2013100+ identical blocks. Depth = capacity to build abstract concepts.'},{emoji:'\ud83d\udc40',title:'Self-attention intuition',body:'Each token asks: "which other tokens matter to me?" In "The cat sat because IT was tired", attention links "it" \u2192 "cat". Multiple heads learn different relationship types in parallel.'},{emoji:'\ud83d\udccd',title:'Positional encoding',body:'Attention alone doesn\'t know word ORDER, so positions are injected into embeddings (RoPE is the modern favorite). Without it, "dog bites man" = "man bites dog"!'}],quiz:[{question:'Self-attention lets tokens\u2026',options:['Delete each other','Weigh their relevance to each other','Train faster','Compress files'],answerIndex:1,explanation:'Every token attends to every other \u2014 context understanding.'},{question:'Positional encoding provides\u2026',options:['GPS location','Word order information','User identity','Grammar rules'],answerIndex:1,explanation:'Attention is order-blind without position info.'}]},{id:'tl1l3',title:'The Training Recipe',emoji:'\ud83c\udf73',xp:80,cards:[{emoji:'\ud83c\udf73',title:'Three-stage recipe',body:'Stage 1: Pretraining on trillions of tokens (months, $millions) \u2192 base model. Stage 2: Supervised fine-tuning on curated examples \u2192 follows instructions. Stage 3: RLHF/DPO \u2192 helpful, harmless, honest.'},{emoji:'\ud83d\udcda',title:'Data is the moat',body:'Quality data mixtures (web, code, books, math) decide model quality. Dedup, filtering, and the right code/text ratio matter more than architecture tweaks. Data engineering IS the secret sauce.'},{emoji:'\u2696\ufe0f',title:'Alignment methods',body:'RLHF: humans rank outputs \u2192 reward model \u2192 RL tuning. DPO: skip the reward model, optimize directly on preferences \u2014 simpler and popular. Anthropic adds Constitutional AI self-critique.'}],quiz:[{question:'The correct training order is\u2026',options:['RLHF \u2192 pretrain \u2192 SFT','Pretrain \u2192 SFT \u2192 RLHF/DPO','SFT only','Random'],answerIndex:1,explanation:'Base knowledge \u2192 instruction following \u2192 preference alignment.'},{question:'DPO differs from RLHF by\u2026',options:['Using more GPUs','Skipping the separate reward model','Avoiding data','Being older'],answerIndex:1,explanation:'Direct Preference Optimization trains straight on rankings.'}]}]},n={id:'tl2',tier:'intermediate',title:'LLM Advanced',subtitle:'Architecture & scaling secrets',emoji:'\ud83e\uddec',lessons:[{id:'tl2l1',title:'Scaling Laws & MoE',emoji:'\ud83d\udcca',xp:110,cards:[{emoji:'\ud83d\udcca',title:'Chinchilla scaling',body:'DeepMind\'s discovery: for a compute budget, model size and training tokens should grow together (~20 tokens per parameter). Many older models were undertrained, not undersized!'},{emoji:'\ud83e\udde9',title:'Mixture of Experts',body:'MoE models have many expert sub-networks; a router activates only 1\u20132 per token. Result: huge capacity, fraction of the compute. The trick behind many frontier models.'},{emoji:'\ud83e\ude9c',title:'Emergent abilities',body:'Some skills (multi-step math, chain-of-thought) appear suddenly at scale rather than gradually. Debated but influential: capability jumps make scaling part science, part exploration.'}],quiz:[{question:'Chinchilla says to scale model size with\u2026',options:['More GPUs only','Proportional training tokens','Bigger batches','Longer prompts'],answerIndex:1,explanation:'~20 tokens per parameter for compute-optimal training.'},{question:'MoE models save compute by\u2026',options:['Smaller vocabularies','Activating only a few experts per token','Skipping attention','Using CPUs'],answerIndex:1,explanation:'The router picks 1-2 experts \u2014 sparse activation.'}]},{id:'tl2l2',title:'Long Context & Attention Tricks',emoji:'\ud83e\ude9f',xp:110,cards:[{emoji:'\ud83d\udc0c',title:'The quadratic problem',body:'Vanilla attention costs grow with the SQUARE of sequence length \u2014 10x longer input = 100x compute. Long-context models needed smarter attention.'},{emoji:'\u26a1',title:'FlashAttention & friends',body:'FlashAttention reorders GPU memory access for exact attention at a fraction of the cost. Sliding-window and grouped-query attention (GQA) cut memory further. This is how 1M-token contexts became real.'},{emoji:'\ud83d\udd0d',title:'Lost in the middle',body:'Models recall info at the start and end of long contexts better than the middle! Practical fix: put critical instructions first or last, and use retrieval to shrink what you stuff in.'}],quiz:[{question:'Vanilla attention scales with sequence length\u2026',options:['Linearly','Quadratically','Not at all','Logarithmically'],answerIndex:1,explanation:'Every token attends to every token: n\xb2 cost.'},{question:'"Lost in the middle" means\u2026',options:['Missing GPUs','Weaker recall for mid-context info','Broken tokenizers','Slow networks'],answerIndex:1,explanation:'Put key info at the start or end of long prompts.'}]},{id:'tl2l3',title:'Reasoning Models',emoji:'\ud83e\udd14',xp:120,cards:[{emoji:'\ud83e\udd14',title:'Test-time compute',body:'New paradigm: let models THINK longer before answering \u2014 generating internal reasoning chains. Accuracy scales with thinking time, not just model size. o-series, Claude extended thinking, Gemini thinking.'},{emoji:'\ud83c\udfc5',title:'RL on verifiable rewards',body:'Reasoning models train with RL on problems with checkable answers (math, code tests). The model discovers its own reasoning strategies \u2014 no human demonstrations of thinking needed.'},{emoji:'\ud83e\uddee',title:'When to use them',body:'Reasoning models: hard math, complex code, multi-step analysis. Regular models: chat, summaries, speed-sensitive tasks. Pros route per-task \u2014 reasoning tokens cost real money.'}],quiz:[{question:'Test-time compute means\u2026',options:['Faster GPUs','Letting models think longer before answering','More training','Bigger contexts'],answerIndex:1,explanation:'Extended internal reasoning improves hard-task accuracy.'},{question:'Reasoning RL works best with\u2026',options:['Vibes','Verifiable rewards (math/code checks)','No feedback','Human typing'],answerIndex:1,explanation:'Checkable answers give clean training signals.'}]}]},o={id:'tl3',tier:'advanced',title:'LLM Professional',subtitle:'Frontier engineering',emoji:'\ud83e\udde0',lessons:[{id:'tl3l1',title:'Serving Systems Design',emoji:'\ud83c\udfed',xp:150,cards:[{emoji:'\ud83c\udfed',title:'The serving stack',body:'vLLM (PagedAttention), TensorRT-LLM, SGLang: continuous batching, paged KV caches, tensor parallelism across GPUs. Goal: maximize tokens/sec/GPU while meeting latency SLOs.'},{emoji:'\ud83d\udcc4',title:'PagedAttention',body:'Treats KV cache like virtual memory pages \u2014 no wasted GPU memory on variable-length sequences. vLLM\'s signature idea; often 2-4x throughput gains. A must-know for infra interviews.'},{emoji:'\ud83c\udfaf',title:'Prefill vs decode',body:'Prefill (processing your prompt) is compute-bound; decode (generating tokens) is memory-bound. Modern servers disaggregate them onto different GPUs for efficiency.'}],quiz:[{question:'PagedAttention manages\u2026',options:['Web pages','KV cache memory like virtual memory','Model weights','User sessions'],answerIndex:1,explanation:'Paging eliminates KV cache fragmentation \u2014 vLLM\'s core trick.'},{question:'Token generation (decode) is mostly bound by\u2026',options:['Compute','Memory bandwidth','Disk','Network'],answerIndex:1,explanation:'Streaming weights and KV cache dominates decode time.'}]},{id:'tl3l2',title:'Interpretability',emoji:'\ud83d\udd2c',xp:150,cards:[{emoji:'\ud83d\udd2c',title:'Opening the black box',body:'Mechanistic interpretability reverse-engineers what neurons and circuits compute. Anthropic found millions of interpretable "features" in Claude \u2014 concepts like "Golden Gate Bridge" you can amplify!'},{emoji:'\ud83d\uddfa\ufe0f',title:'Features & circuits',body:'Sparse autoencoders decompose activations into human-understandable features; circuits show how features combine into behaviors. Goal: audit and steer models from the inside.'},{emoji:'\ud83d\uded1',title:'Why it matters',body:'If we can SEE deception or bias forming inside a model, we can catch problems benchmarks miss. Interpretability is safety infrastructure for the frontier era.'}],quiz:[{question:'Mechanistic interpretability aims to\u2026',options:['Speed up training','Reverse-engineer internal model computations','Compress models','Write prompts'],answerIndex:1,explanation:'Understanding circuits and features inside the network.'},{question:'Sparse autoencoders help by\u2026',options:['Faster inference','Decomposing activations into interpretable features','Storing data','Generating images'],answerIndex:1,explanation:'They factor messy activations into cleaner concepts.'}]},{id:'tl3l3',title:'Frontier Capstone',emoji:'\ud83c\udf96\ufe0f',xp:160,cards:[{emoji:'\ud83c\udf0d',title:'Multimodal frontier',body:'Native multimodal training (text+image+audio+video from scratch), real-time voice conversation, and world models that simulate physics. The line between "language model" and "everything model" is gone.'},{emoji:'\u2697\ufe0f',title:'Synthetic data engines',body:'Frontier labs generate training data WITH models: self-play, verified solutions, constitution-guided rewrites. Quality control of synthetic data is a top-tier skill now.'},{emoji:'\ud83d\ude80',title:'You made it!',body:'You now understand LLMs from tokens to serving systems to interpretability \u2014 deeper than most working engineers. Combine this with the Agentic and GenAI tracks and you\'re certification-ready across AWS, Azure, GCP, and NVIDIA. GO GET THEM! \ud83c\udfc6'}],quiz:[{question:'Synthetic training data is\u2026',options:['Illegal','Model-generated data used to train models','Random noise','Only for images'],answerIndex:1,explanation:'Self-play and verified generations now fuel frontier training.'},{question:'Native multimodal models are trained on\u2026',options:['Text only, then patched','Multiple modalities from the start','Images only','Code only'],answerIndex:1,explanation:'Joint training across modalities from scratch.'}]}]},s=[t,n,o]},290,[]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"infraFoundational",{enumerable:!0,get:function(){return t}}),Object.defineProperty(e,"infraAdvanced",{enumerable:!0,get:function(){return o}}),Object.defineProperty(e,"infraProfessional",{enumerable:!0,get:function(){return n}}),Object.defineProperty(e,"infraTrackWorlds",{enumerable:!0,get:function(){return s}});const t={id:'ti1',tier:'beginner',title:'AI Infrastructure Foundational',subtitle:'From silicon to the first generated token',emoji:'\ud83d\udda5\ufe0f',lessons:[{id:'ti1l1',title:'CPU, GPU & Accelerators',emoji:'\ud83e\udde0',xp:80,cards:[{emoji:'\ud83e\udde0',title:'Different engines',body:'CPUs are flexible and great at varied sequential work. GPUs contain thousands of smaller cores that perform the same operation across lots of data at once \u2014 exactly what matrix-heavy AI workloads need.'},{emoji:'\u2797',title:'AI is matrix math',body:'Neural-network layers repeatedly multiply tensors. GPUs, TPUs, and other accelerators are designed to perform these operations in parallel, so training and inference finish dramatically faster.'},{emoji:'\u2696\ufe0f',title:'Pick for the workload',body:'Data loading, API logic, and orchestration often stay on CPUs. Large model execution belongs on accelerators. Good architecture uses each processor for the work it performs best.'}],quiz:[{question:'Why are GPUs effective for neural networks?',options