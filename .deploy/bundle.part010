nal probability'},{left:'Update beliefs with evidence',right:'Bayes\' theorem'},{left:'Probability-weighted average',right:'Expected value'}]},sk3l1:{kind:'order',prompt:'Run a proper A/B test!',steps:['Define the decision metric','Randomly split users','Run to planned sample size','Compare results','Ship the winner']},sk3l2:{kind:'match',prompt:'Match the analytics concept!',pairs:[{left:'Aggregate rows',right:'GROUP BY'},{left:'Users coming back',right:'Retention'},{left:'Where users drop off',right:'Conversion funnel'},{left:'Question \u2192 query',right:'Text-to-SQL'}]},sk4l1:{kind:'sort',prompt:'Strong interview move or resume filler?',bins:['\ud83d\udcaa Strong move','\ud83d\uddd1\ufe0f Filler'],items:[{text:'Deployed project with metrics',bin:0},{text:'"Familiar with 25 tools"',bin:1},{text:'Saying tradeoffs out loud',bin:0},{text:'Certificates with no projects',bin:1}]},sk4l2:{kind:'order',prompt:'Plan your certification roadmap!',steps:['Azure AI-901 (entry)','AWS AI Practitioner','AWS ML Engineer Associate or Google PMLE','AWS GenAI Developer Professional','NVIDIA GenAI, Agentic AI or Infrastructure']}},t.infraLessonGames)},283,[284]);
__d(function(g,r,i,a,m,e,d){"use strict";Object.defineProperty(e,'__esModule',{value:!0}),Object.defineProperty(e,"infraLessonGames",{enumerable:!0,get:function(){return t}});const t={ti1l1:{kind:'sort',prompt:'Choose the processor that best fits each job!',bins:['\ud83e\udde0 CPU','\u26a1 GPU / accelerator'],items:[{text:'API request orchestration',bin:0},{text:'Operating-system control flow',bin:0},{text:'Large tensor multiplication',bin:1},{text:'Transformer inference',bin:1},{text:'General application logic',bin:0},{text:'Parallel neural-network training',bin:1}]},ti1l2:{kind:'match',prompt:'Match each GPU component to its role!',pairs:[{left:'Tensor Cores',right:'Accelerate matrix math'},{left:'HBM',right:'Hold weights and runtime state'},{left:'Streaming multiprocessor',right:'Run many GPU threads'},{left:'Memory bandwidth',right:'Move model data quickly'}]},ti1l3:{kind:'order',prompt:'Put an inference request in execution order!',steps:['Tokenize the prompt','Prefill the prompt','Build the KV cache','Decode output tokens']},ti1l4:{kind:'match',prompt:'Match precision to approximate bytes per weight!',pairs:[{left:'FP32',right:'4 bytes'},{left:'FP16 / BF16',right:'2 bytes'},{left:'INT8',right:'1 byte'},{left:'4-bit',right:'0.5 byte'}]},ti1l5:{kind:'match',prompt:'Match each serving metric to what it reveals!',pairs:[{left:'TTFT',right:'Wait until output begins'},{left:'Time per output token',right:'Decode speed'},{left:'Tokens per second',right:'Serving throughput'},{left:'P95 latency',right:'Slow-tail user experience'}]},ti2l1:{kind:'sort',prompt:'Does it describe the KV cache or PagedAttention?',bins:['\ud83e\udde0 KV cache','\ud83d\udcc4 PagedAttention'],items:[{text:'Stores keys and values for earlier tokens',bin:0},{text:'Avoids recomputing prior attention state',bin:0},{text:'Allocates cache in non-contiguous blocks',bin:1},{text:'Reduces memory fragmentation',bin:1}]},ti2l2:{kind:'order',prompt:'Run one continuous-batching scheduler cycle!',steps:['Admit requests within capacity','Execute a model step','Remove finished sequences','Insert newly admitted work']},ti2l3:{kind:'match',prompt:'Match the distributed execution pattern!',pairs:[{left:'Tensor parallelism',right:'Split work inside each layer'},{left:'Pipeline parallelism',right:'Place layer groups on stages'},{left:'Data parallelism',right:'Run independent model replicas'},{left:'Expert parallelism',right:'Distribute Mixture-of-Experts blocks'}]},ti2l4:{kind:'match',prompt:'Match the multi-GPU communication technology!',pairs:[{left:'NVLink',right:'High-speed GPU link'},{left:'NVSwitch',right:'Multi-GPU switching fabric'},{left:'NCCL',right:'Optimized GPU collectives'},{left:'All-reduce',right:'Combine values across workers'}]},ti2l5:{kind:'match',prompt:'Match each inference-stack component to its specialty!',pairs:[{left:'vLLM',right:'Efficient LLM scheduling and cache'},{left:'Triton',right:'Serve multiple model types'},{left:'TensorRT-LLM',right:'Optimize transformer execution'},{left:'Model gateway',right:'Auth, quotas, routing and fallbacks'}]},ti3l1:{kind:'match',prompt:'Match each Kubernetes GPU component!',pairs:[{left:'Device plugin',right:'Advertise GPU resources'},{left:'GPU Operator',right:'Manage the GPU software stack'},{left:'MIG',right:'Create hardware-isolated slices'},{left:'Time slicing',right:'Share execution time'}]},ti3l2:{kind:'match',prompt:'Match the scale-out networking term!',pairs:[{left:'RDMA',right:'Low-overhead remote memory access'},{left:'InfiniBand',right:'Purpose-built HPC fabric'},{left:'RoCE',right:'RDMA over Ethernet'},{left:'GPUDirect',right:'Reduce unnecessary data copies'}]},ti3l3:{kind:'order',prompt:'Put the inference autoscaling loop in order!',steps:['Observe queue and latency signals','Compare them with the SLO','Adjust desired replicas','Warm and admit traffic to capacity']},ti3l4:{kind:'match',prompt:'Match the symptom to the first thing to investigate!',pairs:[{left:'Repeated GPU OOM',right:'Memory and admission limits'},{left:'Falling GPU clocks',right:'Power or thermal throttling'},{left:'High queue time',right:'Capacity or scheduling pressure'},{left:'Canary quality regression',right:'Rollback the model release'}]},ti3l5:{kind:'order',prompt:'Route a governed multi-tenant inference request!',steps:['Authenticate the tenant','Apply policy and quota','Choose an approved model','Serve and record usage telemetry']}}},284,[]);
